---
export interface Claim {
  number?: string;
  title: string;
  detail: string;
}

export interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  claims: Claim[];
  accent?: string;
}

const { id, eyebrow = 'WHAT CHANGES', title, claims, accent = '#4388ff' } = Astro.props;
---

<section id={id} class="big-claims" style={`--claim-accent:${accent}`}>
  <header>
    <p>{eyebrow}</p>
    {title && <h2>{title}</h2>}
  </header>
  <div class="claim-list">
    {
      claims.map((claim, index) => (
        <article>
          <span>{claim.number ?? String(index + 1).padStart(2, '0')}</span>
          <h3>{claim.title}</h3>
          <p>{claim.detail}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .big-claims {
    max-width: 80rem;
    margin: 0 auto;
    padding: 6.5rem 1.5rem;
  }
  .big-claims header {
    display: grid;
    grid-template-columns: minmax(10rem, 0.38fr) 1fr;
    gap: 2rem;
    align-items: end;
    margin-bottom: 2.25rem;
  }
  .big-claims header p {
    margin: 0;
    color: var(--claim-accent);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }
  .big-claims header h2 {
    max-width: 48rem;
    margin: 0;
    color: #eef3fa;
    font-size: clamp(2rem, 4vw, 4.2rem);
    line-height: 1;
    letter-spacing: -0.055em;
  }
  .claim-list {
    border-top: 1px solid #27303d;
  }
  .claim-list article {
    display: grid;
    grid-template-columns: minmax(4rem, 0.35fr) minmax(16rem, 1.1fr) minmax(16rem, 1fr);
    gap: 2rem;
    align-items: start;
    padding: 2.2rem 0;
    border-bottom: 1px solid #27303d;
  }
  .claim-list span {
    color: var(--claim-accent);
    font: 700 0.66rem/1 monospace;
    letter-spacing: 0.08em;
  }
  .claim-list h3 {
    max-width: 38rem;
    margin: 0;
    color: #f4f7fb;
    font-size: clamp(1.75rem, 3.2vw, 3.25rem);
    line-height: 1.04;
    letter-spacing: -0.045em;
  }
  .claim-list p {
    max-width: 31rem;
    margin: 0.18rem 0 0;
    color: #8f9baa;
    font-size: 0.95rem;
    line-height: 1.72;
  }
  @media (max-width: 800px) {
    .big-claims {
      padding: 4.5rem 1rem;
    }
    .big-claims header {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }
    .claim-list article {
      grid-template-columns: 2.4rem 1fr;
      gap: 0.8rem;
    }
    .claim-list p {
      grid-column: 2;
    }
  }
</style>
