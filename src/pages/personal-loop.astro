---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import BigClaims from '~/components/product/BigClaims.astro';
import DemoStage from '~/components/product/DemoStage.astro';
import PendingMedia from '~/components/product/PendingMedia.astro';
import ArchitectureMap from '~/components/product/ArchitectureMap.astro';
import StatusBand from '~/components/product/StatusBand.astro';

const metadata = {
  title: 'Personal Loop',
  description: '把任务、隔离执行、测试、独立审查、人类审批和外部交付连接成可恢复闭环。',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="04 · PERSONAL LOOP"
    actions={[
      { variant: 'primary', text: '查看交付架构', href: '#loop-architecture', icon: 'tabler:arrow-down' },
      { text: '进入工程笔记', href: '/engineering' },
    ]}
  >
    <Fragment slot="title"
      >“Agent 说完成了”，<br /><span class="text-accent dark:text-white">还不是一次真实交付。</span></Fragment
    >
    <Fragment slot="subtitle"
      >Personal Loop 面向一个 Owner 的研发工作：固定任务与项目上下文，在隔离工作区实现和测试，经独立 Review
      与人类审批后，再进入 Git、PR 和部署结果对账。</Fragment
    >
    <Fragment slot="image"
      ><img
        class="w-full rounded-xl border border-slate-700 shadow-2xl"
        src="/shots/tasks-live.png"
        alt="NiuMa 任务看板中的进行中任务与运行状态"
      /></Fragment
    >
  </Hero>

  <BigClaims
    title="完成必须由工作流和证据共同确认。"
    accent="#bd8cff"
    claims={[
      {
        title: 'Workflow 拥有状态。',
        detail: 'Task、Run、Step、Approval、Evidence 与 External Action 分开记录；Agent 只负责节点内推理和执行。',
      },
      {
        title: '每一次重试继承失败。',
        detail: '上一轮错误、Review 和证据进入下一轮提示，避免状态保留了但执行者仍从头猜测。',
      },
      {
        title: '外部成功必须真实对账。',
        detail: '本地生成 PR 文案或部署命令不等于完成；必须读取 Git、CI 和服务健康的真实回执。',
      },
    ]}
  />

  <ArchitectureMap
    id="loop-architecture"
    accent="#bd8cff"
    title="一个 Owner，一条可恢复、可审核的交付链路。"
    description="确定性 workflow 控制状态转换，不确定性 Agent 负责调查和执行；高风险边界由人类作出明确决定。"
    lanes={[
      {
        label: 'Task Intake',
        caption: '先固定要解决什么',
        nodes: [{ title: 'Feishu / manual task' }, { title: 'Acceptance & owner' }, { title: 'Context snapshot' }],
      },
      {
        label: 'Isolated Work',
        caption: '实现不污染当前工作区',
        nodes: [{ title: 'Repository worktree' }, { title: 'Agent investigation' }, { title: 'Patch & tests' }],
      },
      {
        label: 'Independent Gate',
        caption: '实现者不能自证完成',
        nodes: [{ title: 'Evidence manifest' }, { title: 'Independent review' }, { title: 'Human approval' }],
      },
      {
        label: 'External Delivery',
        caption: '结果必须对账',
        nodes: [{ title: 'Draft PR / merge' }, { title: 'CI / deploy receipt' }, { title: 'Health observation' }],
      },
    ]}
    note="同一任务不能并发执行；不同任务可以并行。共享仓库镜像等临界资源使用窄锁，不把整个 runner 全局串行化。"
  />

  <DemoStage
    eyebrow="TARGET DELIVERY EXPERIENCE"
    title="从一句任务，到一个带证据的候选交付。"
    description="当前页面先明确正式动图需要覆盖的完整流程。真实 Loop UI 录像将在对应环境素材提供后补入。"
    accent="#bd8cff"
    status="BRANCH VALIDATION"
    steps={[
      { title: '任务进入并固定验收', detail: '记录 Owner、仓库、环境、预期结果和禁止事项。' },
      { title: 'Agent 在 worktree 执行', detail: '调查、修改和测试不覆盖用户当前工作目录。' },
      { title: '独立 Review 检查证据', detail: '读取真实 diff、测试输出和历史 oracle，决定通过或重试。' },
      { title: '人类批准外部动作', detail: '审批绑定 candidate SHA，再创建 PR、合并或部署并读取回执。' },
    ]}
    caption="这一方向不使用平台 Channel 截图占位。待 Personal Loop 环境素材提供后，将按任务、执行、独立审查和外部交付四步制作专属动图。"
  >
    <PendingMedia
      index="04"
      title="等待 Personal Loop 素材"
      description="需要任务进入、隔离 worktree 执行、Review 与证据，以及 PR 或部署回执的连续画面。"
      accent="#bd8cff"
    />
  </DemoStage>

  <BigClaims
    eyebrow="HUMAN GATES"
    accent="#bd8cff"
    claims={[
      {
        title: '没有可靠 oracle，就交给人。',
        detail: '缺少测试、历史行为依据或明确负责人时进入 NEEDS_HUMAN，不让模型自己发明验收标准。',
      },
      {
        title: '候选改变，审批失效。',
        detail: '批准针对具体 candidate SHA 和证据；修改发生后必须重新建立审查与授权。',
      },
      {
        title: '部署无法观察，就不自动部署。',
        detail: '制品、环境、补偿和健康观察契约不完整时，流程停在人工可接管节点。',
      },
    ]}
  />

  <StatusBand
    items={[
      { label: 'Task model', value: '持久任务、运行轮次与步骤状态', state: 'internal' },
      { label: 'Execution', value: '隔离 worktree、测试与证据收集', state: 'internal' },
      { label: 'Review', value: '独立审查、失败继承与人工关口', state: 'validation' },
      { label: 'Delivery', value: 'PR 与部署外部状态持续对账', state: 'validation' },
    ]}
  />

  <CallToAction
    title="实现细节、协议和被否证的路径都留在工程记录里。"
    actions={[
      { variant: 'primary', text: '进入工程笔记', href: '/engineering', icon: 'tabler:arrow-right' },
      { text: '返回首页', href: '/' },
    ]}
  />
</Layout>
