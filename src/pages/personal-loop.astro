---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Personal Loop',
  description: 'NiuMa 的个人研发交付闭环：任务、上下文、隔离执行、测试、独立审查、审批与外部交付。',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="04 · PERSONAL LOOP"
    actions={[
      { variant: 'primary', text: '查看交付流程', href: '#workflow', icon: 'tabler:arrow-down' },
      { text: '进入工程笔记', href: '/engineering' },
    ]}
  >
    <Fragment slot="title">
      把一次 Agent 修改，<br /><span class="text-accent dark:text-white">变成可验证的研发交付。</span>
    </Fragment>
    <Fragment slot="subtitle">
      Personal Loop 面向一个 Owner 的研发工作：从飞书或手动接收任务，固定项目上下文，在隔离工作区执行与测试，经独立
      Review 和人类审批后，再进入 Git、PR 与部署环节。
    </Fragment>
    <Fragment slot="image">
      <img
        class="w-full rounded-xl border border-slate-700 shadow-2xl"
        src="/shots/channel-live.png"
        alt="NiuMa 当前任务入口与运行状态界面"
      />
    </Fragment>
  </Hero>

  <Note
    title="当前状态"
    description="该方向在独立分支持续验证；任务、执行、测试、Review、审批与交付控制已有实现，自动部署仍受严格证据条件约束。"
  />

  <Steps
    id="workflow"
    tagline="DELIVERY WORKFLOW"
    title="一个任务只有在证据完整时才向前推进。"
    items={[
      {
        title: '01 · 任务进入',
        description: '从飞书显式接收或由 Owner 手动指派，记录任务来源、目标和验收要求。',
        icon: 'tabler:inbox',
      },
      {
        title: '02 · 固定上下文',
        description: '将仓库、分支、环境、规则和预期结果固化为本次运行的上下文快照。',
        icon: 'tabler:camera',
      },
      {
        title: '03 · 隔离执行',
        description: 'Agent 在独立 worktree 中调查、修改和测试，不覆盖 Owner 正在使用的工作区。',
        icon: 'tabler:git-branch',
      },
      {
        title: '04 · 独立审查',
        description: 'Review 使用独立上下文和证据，不能直接复用实现 Agent 对自身结果的判断。',
        icon: 'tabler:zoom-check',
      },
      {
        title: '05 · 人类决策',
        description: '审批绑定候选版本、证据和有效期；拒绝、重试或继续都有明确状态。',
        icon: 'tabler:user-shield',
      },
      {
        title: '06 · 外部交付',
        description: '创建 Draft PR、合并或部署后读取外部回执，并将最终状态返回任务入口。',
        icon: 'tabler:rocket',
      },
    ]}
  />

  <Content
    isReversed
    tagline="CONTROL PLANE"
    title="Workflow 拥有状态，Agent 只负责节点内的推理与执行。"
    items={[
      {
        title: '状态分层',
        description:
          'Task、Workflow Run、Step Run、Approval、Evidence 与 External Action 分开记录，避免一个状态覆盖所有事实。',
      },
      {
        title: '并发约束',
        description: '同一任务不能并发执行；不同任务可以并行，共享仓库镜像等临界资源使用窄锁保护。',
      },
      { title: '失败可恢复', description: '每一轮保留输入、证据和错误；重试必须收到上一轮失败原因，而不是从头猜测。' },
    ]}
  >
    <Fragment slot="image"
      ><img
        class="w-full rounded-xl border border-slate-700 shadow-2xl"
        src="/shots/machine.png"
        alt="NiuMa Machine 页面中的执行环境与活动状态"
        loading="lazy"
      /></Fragment
    >
  </Content>

  <Features2
    tagline="EVIDENCE CONTRACT"
    title="完成不是 Agent 的一句结论。"
    subtitle="流程依据可复查的产物改变状态，并将关键外部动作留给明确的人类关口。"
    columns={3}
    items={[
      {
        title: '实现证据',
        description: '补丁、提交候选、命令输出、测试结果与 exit code 对应同一次运行。',
        icon: 'tabler:file-code',
      },
      {
        title: '审查证据',
        description: '独立 Review 读取真实变更和验收标准，指出阻断问题或给出可追溯结论。',
        icon: 'tabler:clipboard-check',
      },
      {
        title: '外部回执',
        description: 'Git、PR 与部署平台的真实状态用于对账；本地生成的文案不能替代外部成功。',
        icon: 'tabler:receipt',
      },
    ]}
  >
    <Fragment slot="bg"><div class="absolute inset-0 bg-slate-50 dark:bg-slate-950"></div></Fragment>
  </Features2>

  <Content
    tagline="HUMAN GATES"
    title="高风险动作需要绑定对象、证据和有效期的审批。"
    items={[
      { title: '候选版本明确', description: '审批针对具体 candidate SHA；候选发生变化后，旧审批不能继续使用。' },
      { title: '权限范围明确', description: '提交、推送、合并与部署是不同动作，流程不能用一次宽泛同意覆盖全部权限。' },
      {
        title: '结果可对账',
        description: '动作结束后读取外部状态；失败进入补偿或人工处理，不把请求已发送当作交付完成。',
      },
    ]}
  >
    <Fragment slot="image"
      ><img
        class="w-full rounded-xl border border-slate-700 shadow-2xl"
        src="/shots/channel.png"
        alt="Channel 与 Thread 中的任务反馈和人类协作入口"
        loading="lazy"
      /></Fragment
    >
  </Content>

  <Features
    tagline="CURRENT BOUNDARY"
    title="不满足控制条件时，流程必须停下来。"
    columns={2}
    items={[
      {
        title: '没有可靠验收依据',
        description: '缺少测试、历史 oracle 或明确负责人时，任务进入 NEEDS_HUMAN，而不是让模型自行宣布通过。',
        icon: 'tabler:hand-stop',
      },
      {
        title: '没有可对账部署契约',
        description: '无法精确识别制品、环境与健康观察时，只交付到人工可接管节点，不宣传为全自动部署。',
        icon: 'tabler:alert-triangle',
      },
    ]}
  />

  <CallToAction
    title="查看这些边界如何落到协议与工程实现。"
    subtitle="工程笔记收录 runtime 抽象、daemon 选型、鉴权检测与例程执行设计。"
    actions={[
      { variant: 'primary', text: '进入工程笔记', href: '/engineering', icon: 'tabler:arrow-right' },
      { text: '返回首页', href: '/' },
    ]}
  />
</Layout>
