---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import BigClaims from '~/components/product/BigClaims.astro';
import DemoStage from '~/components/product/DemoStage.astro';
import ArchitectureMap from '~/components/product/ArchitectureMap.astro';
import StatusBand from '~/components/product/StatusBand.astro';

const metadata = {
  title: 'Agent Runtime',
  description: '把不同 Agent runtime 接入同一个可远程寻址、可观察、可控制的本地执行底座。',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="01 · AGENT RUNTIME"
    actions={[
      { variant: 'primary', text: '查看运行架构', href: '#architecture', icon: 'tabler:arrow-down' },
      { text: '阅读抽象设计', href: '/posts/runtime-abstraction' },
    ]}
  >
    <Fragment slot="title"
      >Agent 不必困在终端里。<br /><span class="text-accent dark:text-white">它可以被远程找到并继续工作。</span
      ></Fragment
    >
    <Fragment slot="subtitle"
      >NiuMa 不替代 Codex、Claude Code 或 Cursor
      Agent，而是把它们放到统一的本机执行边界后面，让团队能够寻址、观察和控制真实运行。</Fragment
    >
    <Fragment slot="image"
      ><img
        class="w-full rounded-xl border border-slate-700 shadow-2xl"
        src="/shots/machine.png"
        alt="NiuMa Machine 与 runtime 状态"
      /></Fragment
    >
  </Hero>

  <BigClaims
    title="Runtime 是执行引擎，平台负责让工作可持续。"
    claims={[
      { title: '保留本地能力。', detail: '代码、文件、认证和开发工具仍在用户机器；不为了远程入口复制一套低能力沙箱。' },
      { title: '抹平控制差异。', detail: '启动、会话、流式事件、取消、恢复和诊断被映射为平台可理解的执行契约。' },
      {
        title: '每次运行都有归属。',
        detail: '消息、员工、Machine、runtime scope 与 Thread 绑定，不产生脱离业务上下文的孤立进程。',
      },
    ]}
  />

  <ArchitectureMap
    id="architecture"
    title="远程控制不等于远程桌面。"
    description="控制面只下发业务意图；本机 daemon 决定执行环境并持续上报可验证事件。"
    lanes={[
      {
        label: 'Request',
        caption: '远程业务入口',
        nodes: [{ title: 'Channel @AI员工' }, { title: 'Mobile task' }, { title: 'Permission decision' }],
      },
      {
        label: 'Server',
        caption: '组织与运行状态',
        nodes: [{ title: 'Message & Thread' }, { title: 'Employee routing' }, { title: 'Run & Inbox' }],
      },
      {
        label: 'Daemon',
        caption: '用户机器上的执行代理',
        nodes: [{ title: 'Capability detection' }, { title: 'Scoped session' }, { title: 'Workspace & sandbox' }],
      },
      {
        label: 'Runtime',
        caption: '可替换的执行引擎',
        nodes: [{ title: 'Codex / Claude' }, { title: 'Cursor / Gemini' }, { title: 'Kimi / OpenCode / Hermes' }],
      },
    ]}
    note="Server 不直接读写本机 workspace；前端不硬编码模型列表。创建员工时只使用 daemon 实际探测并上报的能力。"
  />

  <DemoStage
    title="连接一台机器，然后从团队空间调用它。"
    description="Machine 页面负责建立可信执行边界；Channel 页面负责向具体员工发起任务并接收运行事件。"
    steps={[
      { title: '连接 Machine', detail: '安装 daemon，建立长期连接并上报版本与 heartbeat。' },
      { title: '探测 runtime', detail: '检测命令、认证、模型与沙箱能力，不能只看进程存在。' },
      { title: '绑定 AI员工', detail: '员工选择真实可用的 runtime、模型和执行位置。' },
      { title: '从 Channel 调用', detail: '任务进入 scoped session，过程和结果回到原 Thread。' },
    ]}
    status="RUNTIME FLOW · REAL PRODUCT"
    caption="真实产品流程：验收 Machine 与 runtime 能力，完成 Agent 运行配置，再把 Agent 加入指定 Channel。创建动作继续受 Machine 归属权限约束。"
  >
    <video
      autoplay
      muted
      loop
      playsinline
      poster="/shots/runtime-flow-poster.jpg"
      aria-label="从 Machine 能力验收到配置 Agent，再加入 Channel 的 Agent Runtime 流程"
      ><source src="/shots/runtime-flow.webm" type="video/webm" /></video
    >
  </DemoStage>

  <StatusBand
    items={[
      { label: 'Control plane', value: 'Workspace Server 与 Web 已运行', state: 'live' },
      { label: 'Local executor', value: 'macOS / Linux daemon 持续连接', state: 'live' },
      { label: 'Runtime adapters', value: '多 runtime 真实探测与会话适配', state: 'internal' },
      { label: 'Mobile', value: '按 Web 工作台模型继续推进', state: 'validation' },
    ]}
  />

  <CallToAction
    title="执行底座解决“在哪里干活”，AI员工继续回答“长期负责什么”。"
    actions={[
      { variant: 'primary', text: '继续看 AI员工', href: '/employees', icon: 'tabler:arrow-right' },
      { text: '返回首页', href: '/' },
    ]}
  />
</Layout>
