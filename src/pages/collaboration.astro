---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import BigClaims from '~/components/product/BigClaims.astro';
import DemoStage from '~/components/product/DemoStage.astro';
import PendingMedia from '~/components/product/PendingMedia.astro';
import ArchitectureMap from '~/components/product/ArchitectureMap.astro';
import StatusBand from '~/components/product/StatusBand.astro';

const metadata = {
  title: '办公协作',
  description: '从个人分身和全局 Agent 的失败中，收敛到按项目、版本与责任域组织的协作。',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="03 · OFFICE COLLABORATION"
    actions={[
      { variant: 'primary', text: '查看当前设计', href: '#responsibility-route', icon: 'tabler:arrow-down' },
      { text: '查看三次演进', href: '#evolution' },
    ]}
  >
    <Fragment slot="title"
      >个人已经快了，<br /><span class="text-accent dark:text-white">团队为什么还在等待？</span></Fragment
    >
    <Fragment slot="subtitle"
      >Coding Agent 缩短了个人实现时间，但跨职责协作仍要找人、补背景和等待授权。NiuMa
      经过三次探索，把问题从“共享所有上下文”改成“在正确边界内找到正确负责人”。</Fragment
    >
    <Fragment slot="image"
      ><img
        class="w-full rounded-xl border border-slate-700 shadow-2xl"
        src="/shots/channel-live.png"
        alt="NiuMa Channel 中的人与 AI员工协作"
      /></Fragment
    >
  </Hero>

  <BigClaims
    id="evolution"
    eyebrow="THREE ITERATIONS"
    title="每一版，都减少系统需要占有的上下文。"
    accent="#f3aa4e"
    claims={[
      {
        number: 'V1',
        title: '个人 AI 分身。',
        detail:
          '试图复制每个人的上下文并代表本人回答。效果难控制，也要求用户从 Codex、Claude 迁移到新的工作入口，因此停止。',
      },
      {
        number: 'V2',
        title: '飞书全局 Agent。',
        detail: '定时汇总群聊和私聊，判断何时介入。飞书接入限制、体验摩擦和全局上下文维护成本使方案停止。',
      },
      {
        number: 'V3',
        title: '项目责任协作。',
        detail: '保留每个人自己的 Agent；项目入口只管理项目资料、责任关系和最小授权，把问题路由给真正负责的人。',
      },
    ]}
  />

  <ArchitectureMap
    id="responsibility-route"
    accent="#f3aa4e"
    title="协作系统不替人工作，只缩短找到责任人的路径。"
    description="项目总 Agent 不拥有公司全局上下文，也不接管个人 Agent。它按项目、版本和责任域组织一次明确交接。"
    lanes={[
      {
        label: 'Personal Tool',
        caption: '不迁移已有工作入口',
        nodes: [{ title: 'A 的 Codex / Claude' }, { title: 'NiuMa skill / CLI' }],
      },
      {
        label: 'Project Boundary',
        caption: '只理解当前项目',
        nodes: [{ title: 'Project & version' }, { title: 'Docs & decisions' }, { title: 'Responsibility map' }],
      },
      {
        label: 'Owner Decision',
        caption: '负责人保留决定权',
        nodes: [{ title: 'Agent may answer' }, { title: 'Human takes over' }, { title: 'Transfer / reject' }],
      },
      {
        label: 'Isolated Return',
        caption: '最小上下文回到原工具',
        nodes: [{ title: 'Authorized answer' }, { title: 'Source boundary' }, { title: 'Audit record' }],
      },
    ]}
    note="该架构正在独立分支验证，不作为已上线功能宣传。当前主线已经具备 Channel、Thread、AI员工、Machine、权限与运行状态基础。"
  />

  <DemoStage
    eyebrow="TARGET EXPERIENCE"
    title="A 不需要知道该找谁，也不需要离开自己的 Agent。"
    description="这一段先用目标步骤定义正式动图的验收脚本；等独立分支素材提供后，再补入真实 CLI、责任路由与负责人确认录像。"
    accent="#f3aa4e"
    status="DESIGN VALIDATION"
    steps={[
      { title: 'A 在个人 Agent 中提问', detail: 'skill/CLI 携带当前项目和问题，不上传全部个人历史。' },
      { title: '项目入口解析责任域', detail: '根据版本、资料和责任关系定位到 B。' },
      { title: 'B 决定处理方式', detail: '授权 B-agent 回答、本人接管、转交或拒绝。' },
      { title: '结果返回 A 的原工作流', detail: '只返回被授权内容、来源边界和可追踪记录。' },
    ]}
    caption="这一方向不复用当前 NiuMa 平台截图。待独立分支素材提供后，将按提问、责任路由、负责人确认和结果回传四步制作专属动图。"
    isReversed
  >
    <PendingMedia
      index="03"
      title="等待办公协作分支素材"
      description="需要项目入口、责任路由、负责人授权，以及结果回到个人 Agent 的连续画面。"
      accent="#f3aa4e"
    />
  </DemoStage>

  <BigClaims
    eyebrow="DESIGN CONSTRAINTS"
    accent="#f3aa4e"
    claims={[
      { title: '不迁移个人工具。', detail: '协作能力进入已有 Codex、Claude 工作流，而不是要求所有成员更换开发入口。' },
      { title: '不建立公司全局上下文。', detail: '资料按项目、版本和责任域隔离，默认不读取无关群聊、私聊或个人历史。' },
      { title: '不绕过真正负责人。', detail: '系统加速寻址和交接，但跨职责回答仍由负责人授权，且授权可以拒绝和撤销。' },
    ]}
  />

  <StatusBand
    items={[
      { label: 'V1', value: '个人分身上下文方案已停止', state: 'record' },
      { label: 'V2', value: '飞书全局 Agent 方案已停止', state: 'record' },
      { label: 'Foundation', value: 'Channel、Thread 与员工协作已运行', state: 'live' },
      { label: 'V3', value: '项目责任协作在独立分支验证', state: 'validation' },
    ]}
  />

  <CallToAction
    title="团队协作负责找到正确的人；Personal Loop 负责把一个人的任务交付到底。"
    actions={[
      { variant: 'primary', text: '继续看 Personal Loop', href: '/personal-loop', icon: 'tabler:arrow-right' },
      { text: '返回首页', href: '/' },
    ]}
  />
</Layout>
