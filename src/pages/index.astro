---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import BigClaims from '~/components/product/BigClaims.astro';
import DemoStage from '~/components/product/DemoStage.astro';
import ArchitectureMap from '~/components/product/ArchitectureMap.astro';
import StatusBand from '~/components/product/StatusBand.astro';
import MobileShowcase from '~/components/product/MobileShowcase.astro';

const metadata = { title: 'NiuMa — 让 Agent 进入组织工作', ignoreTitleTemplate: true };
---

<Layout metadata={metadata}>
  <Hero
    tagline="NiuMa · AI EMPLOYEE PLATFORM"
    actions={[
      { variant: 'primary', text: '查看真实工作流', href: '#workflow', icon: 'tabler:arrow-down' },
      { text: '了解 AI员工', href: '/employees' },
    ]}
  >
    <Fragment slot="title">
      让你电脑上的 Agent，<br /><span class="text-accent dark:text-white">成为组织里的 AI员工。</span>
    </Fragment>
    <Fragment slot="subtitle">
      NiuMa 为 Agent 增加岗位、业务入口和协作空间。人可以从
      Web、手机或飞书找到它；它在绑定的电脑上使用真实工具工作，并把过程、权限和结果带回团队。
    </Fragment>
    <Fragment slot="image">
      <img
        class="w-full rounded-xl border border-slate-700 shadow-2xl"
        src="/shots/channel.png"
        alt="NiuMa Channel 中的人与 AI员工共同工作，右侧执行面板显示运行中的任务"
      />
    </Fragment>
  </Hero>

  <BigClaims
    eyebrow="THE PRODUCT SHIFT"
    title="不是多一个聊天框，而是多一个能被管理的工作角色。"
    claims={[
      {
        title: '从任何入口找到它。',
        detail: 'Web、移动端、飞书和个人 CLI 都可以成为任务入口；用户不必回到那台电脑前重新打开 Agent。',
      },
      {
        title: '在你的环境里完成工作。',
        detail: '代码、文件、runtime 和 workspace 留在执行机器；平台管理组织关系、任务状态与权限。',
      },
      {
        title: '岗位和资料属于员工。',
        detail: '职责、规则、参考资料、skills 与长期工作记录围绕 AI员工持续存在，不随一次对话消失。',
      },
      {
        title: '人只在关键节点出现。',
        detail: '日常工作由员工持续处理；资料冲突、敏感写入、纠错和最终交付进入明确的人类关口。',
      },
    ]}
  />

  <DemoStage
    id="workflow"
    eyebrow="ONE REQUEST · END TO END"
    title="人在 Channel 发起，Agent 在电脑上完成。"
    description="演示重点不是聊天，而是一条任务如何跨过入口、路由、本机执行和结果回写。"
    steps={[
      { title: '明确寻址', detail: '用户在 Channel 中 @ 对应岗位员工。' },
      { title: '平台路由', detail: 'Server 固定消息、员工、Machine 与运行 scope。' },
      { title: '本机执行', detail: 'daemon 调用已认证的 runtime 和员工 workspace。' },
      { title: '结果回到团队', detail: '状态、回复、权限请求和产物进入原 Thread。' },
    ]}
    caption="真实桌面产品录制：任务从 Channel 进入，AI员工在绑定机器上执行，并把状态和结果带回原协作空间。"
  >
    <video autoplay muted loop playsinline poster="/shots/channel-live-poster.jpg"
      ><source src="/shots/channel-live.webm" type="video/webm" /></video
    >
  </DemoStage>

  <MobileShowcase
    id="mobile-app"
    title="电脑执行，手机让工作随时可达。"
    description="NiuMa App 不是缩小版终端，而是组织工作入口：查看 Channel、找到 AI员工、确认 Machine 状态，并在需要时处理审批与异常。"
  />

  <ArchitectureMap
    eyebrow="BUSINESS & SYSTEM ARCHITECTURE"
    title="入口属于业务，状态属于平台，执行留在本机。"
    description="一条任务只经过必要边界：入口负责表达意图，Server 负责组织状态，daemon 负责真实执行，结果回到原业务表面。"
    lanes={[
      {
        label: 'Work Entry',
        caption: '人和外部事件从这里进入',
        nodes: [{ title: 'Web / Mobile' }, { title: 'Feishu' }, { title: 'CLI / Skill' }],
      },
      {
        label: 'Workspace Server',
        caption: '业务状态唯一写入方',
        nodes: [{ title: 'Workspace & Channel' }, { title: 'AI员工 & Task' }, { title: 'Inbox & Approval' }],
      },
      {
        label: 'Machine Daemon',
        caption: '本地控制与能力探测',
        nodes: [{ title: 'Runtime Adapter' }, { title: 'Employee Workspace' }, { title: 'Permission Execution' }],
      },
      {
        label: 'Work Output',
        caption: '结果回到可继续协作的位置',
        nodes: [{ title: 'Thread & Activity' }, { title: 'Business Reply' }, { title: 'Code / PR / Evidence' }],
      },
    ]}
    note="平台不直接操作用户文件或 runtime；daemon 不拥有组织业务状态。两侧通过长期连接和明确协议交换执行请求与事件。"
  />

  <Features2
    id="directions"
    tagline="FOUR DIRECTIONS"
    title="四次探索，回答四个连续的问题。"
    subtitle="从 Agent 能运行，到员工能承担业务，再到团队协作与个人交付。"
    columns={2}
    items={[
      {
        title: '01 · Agent Runtime',
        description: '如何从远端寻址并控制用户电脑上的不同 Agent runtime。',
        icon: 'tabler:device-desktop-code',
        callToAction: { text: '查看运行底座', href: '/runtime' },
      },
      {
        title: '02 · AI员工',
        description: '如何让 Agent 获得岗位、外部入口、组织资料和持续改进机制。',
        icon: 'tabler:user-bolt',
        callToAction: { text: '查看 AI员工', href: '/employees' },
      },
      {
        title: '03 · 办公协作',
        description: '如何按项目和责任域交换上下文，而不是建立一个全局 Agent。',
        icon: 'tabler:users-group',
        callToAction: { text: '查看协作演进', href: '/collaboration' },
      },
      {
        title: '04 · Personal Loop',
        description: '如何把 Agent 修改连接到测试、Review、审批和真实交付。',
        icon: 'tabler:refresh-dot',
        callToAction: { text: '查看交付闭环', href: '/personal-loop' },
      },
    ]}
  />

  <StatusBand
    items={[
      { label: 'Platform', value: 'Server、Web 与本机 daemon 持续运行', state: 'live' },
      { label: 'AI employees', value: '飞书客服与飞书助理已用于内部业务', state: 'internal' },
      { label: 'Collaboration', value: '项目责任协作在独立分支验证', state: 'validation' },
      { label: 'Personal Loop', value: '研发交付闭环在独立项目验证', state: 'validation' },
    ]}
  />

  <CallToAction
    title="从一个真实岗位开始理解 NiuMa。"
    subtitle="AI员工页面展示岗位、资料、业务入口、审批与持续改进如何组成一个长期工作身份。"
    actions={[
      { variant: 'primary', text: '进入 AI员工', href: '/employees', icon: 'tabler:arrow-right' },
      { text: '阅读工程笔记', href: '/engineering' },
    ]}
  />
</Layout>
