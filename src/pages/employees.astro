---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import BigClaims from '~/components/product/BigClaims.astro';
import DemoStage from '~/components/product/DemoStage.astro';
import ArchitectureMap from '~/components/product/ArchitectureMap.astro';
import StatusBand from '~/components/product/StatusBand.astro';

const metadata = { title: 'AI员工', description: '为 Agent 配置岗位、业务入口、组织资料、权限边界与持续改进机制。' };
---

<Layout metadata={metadata}>
  <Hero
    tagline="02 · AI EMPLOYEE"
    actions={[
      { variant: 'primary', text: '查看业务链路', href: '#employee-architecture', icon: 'tabler:arrow-down' },
      { text: '查看源码', href: 'https://github.com/omiyeong/niuma-core', target: '_blank' },
    ]}
  >
    <Fragment slot="title"
      >从一次回答，<br /><span class="text-accent dark:text-white">变成长期负责一个岗位。</span></Fragment
    >
    <Fragment slot="subtitle"
      >AI员工拥有职责、规则、业务入口、参考资料、skills
      和工作记录。它持续接触真实问题，在明确权限边界内处理业务，并把纠错沉淀为下一次工作的依据。</Fragment
    >
    <Fragment slot="image"
      ><img
        class="w-full rounded-xl border border-slate-700 shadow-2xl"
        src="/shots/employee.png"
        alt="NiuMa AI员工详情页"
      /></Fragment
    >
  </Hero>

  <BigClaims
    eyebrow="FROM AGENT TO EMPLOYEE"
    title="变化不在模型，而在工作身份。"
    accent="#4fd6a0"
    claims={[
      {
        title: '先定义职责，再接受任务。',
        detail: '岗位描述和工作规则决定应该处理什么、如何表达、何时拒绝以及何时转交人类。',
      },
      {
        title: '让业务主动找到它。',
        detail: '飞书私聊、群聊、Channel 和 routine 都能成为事件入口，员工不需要等待用户打开聊天窗口。',
      },
      {
        title: '让知识随工作持续更新。',
        detail: '资料索引、高频问题、人工纠正和真实业务活动形成可审核的长期知识资产。',
      },
    ]}
  />

  <ArchitectureMap
    id="employee-architecture"
    accent="#4fd6a0"
    title="一个 AI员工，由岗位、入口、资料和控制边界共同组成。"
    description="模型只是推理能力；真正决定业务效果的是它收到什么事件、允许读取什么、能采取什么动作，以及结果如何被监督。"
    lanes={[
      {
        label: 'Business Event',
        caption: '持续进入的真实工作',
        nodes: [{ title: '飞书客服消息' }, { title: '群聊 / Thread @' }, { title: 'Routine / Platform task' }],
      },
      {
        label: 'Employee Identity',
        caption: '长期工作身份',
        nodes: [{ title: 'Role & work rules' }, { title: 'Tone & skills' }, { title: 'Runtime session scope' }],
      },
      {
        label: 'Knowledge & Action',
        caption: '按岗位收敛信息和工具',
        nodes: [{ title: 'Reference index' }, { title: 'Source documents' }, { title: 'Tool policy & sandbox' }],
      },
      {
        label: 'Human Control',
        caption: '输出、纠错和进化',
        nodes: [
          { title: 'Inbox draft / direct reply' },
          { title: 'Activity & evidence' },
          { title: 'Learning proposal approval' },
        ],
      },
    ]}
    note="飞书资料链接直接写进岗位规则；工具策略限制全局搜索和外部发送。自进化只形成候选更新，必须由负责人审核后生效。"
  />

  <DemoStage
    title="像创建员工一样配置，然后让它进入真实业务。"
    description="当前已有飞书客服、飞书助理和个人分身模板。模板给出默认能力与安全策略，负责人只补充岗位、资料和业务选择。"
    accent="#4fd6a0"
    steps={[
      { title: '选择员工模板', detail: '从飞书客服、飞书助理或个人分身开始。' },
      { title: '明确岗位与资料', detail: '填写职责、工作规则、语气和允许引用的飞书资料。' },
      { title: '完成入口与权限', detail: '连接飞书、选择 Machine，校验 runtime、沙箱和平台权限。' },
      { title: '监督真实工作', detail: '在 Activity、Thread 和 Inbox 查看回答、草稿、审批和异常。' },
    ]}
    status="AI EMPLOYEE FLOW · REAL PRODUCT"
    caption="真实产品流程：从岗位模板创建员工，配置职责与回答边界，完成业务授权验收，最后在 Channel 中按员工配置回答并明确转人工范围。"
  >
    <video
      autoplay
      muted
      loop
      playsinline
      poster="/shots/ai-employee-flow-poster.jpg"
      aria-label="从飞书客服模板、岗位配置和授权验收到按规则回答的 AI 员工流程"
      ><source src="/shots/ai-employee-flow.webm" type="video/webm" /></video
    >
  </DemoStage>

  <BigClaims
    eyebrow="WHY IT HOLDS UP"
    accent="#4fd6a0"
    claims={[
      {
        title: '资料不足时，它应该停下来。',
        detail: '没有权威资料或来源冲突时，明确说明缺口并转交人类，而不是补全一个看似合理的答案。',
      },
      {
        title: '权限不足时，它不能绕过去。',
        detail: '外部写入、敏感数据和高风险动作由 Tool Policy、沙箱与 Inbox 审批共同约束。',
      },
      {
        title: '纠错不是一句临时提示。',
        detail: '真实问题、人工修改和失败原因进入候选知识或岗位规则，审核后影响后续工作。',
      },
    ]}
  />

  <StatusBand
    items={[
      { label: 'Templates', value: '飞书客服、飞书助理、个人分身', state: 'live' },
      { label: 'Business use', value: '多名客服 AI员工在公司内部运行', state: 'internal' },
      { label: 'Knowledge', value: '资料索引、原文回查与问题知识库', state: 'internal' },
      { label: 'Learning', value: '候选复盘、人工验证与批准生效', state: 'validation' },
    ]}
  />

  <CallToAction
    title="一个员工可以长期负责；下一步是多个成员如何围绕项目协作。"
    actions={[
      { variant: 'primary', text: '继续看办公协作', href: '/collaboration', icon: 'tabler:arrow-right' },
      { text: '返回首页', href: '/' },
    ]}
  />
</Layout>
